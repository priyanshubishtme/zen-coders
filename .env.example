# AccessFix configuration. Copy to .env and adjust. Every value has a safe default;
# the app runs with no .env at all (LLM off, in-memory store).

# --- API server ---
PORT=4000
NODE_ENV=development
# Comma-separated origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# --- Limits ---
# Max pasted HTML size in bytes (500 KB).
MAX_HTML_BYTES=512000
# Hard timeout for one scan (render + axe), in ms. The browser context is killed after this.
SCAN_TIMEOUT_MS=30000
# Hard timeout for any HTTP request, in ms.
REQUEST_TIMEOUT_MS=60000
# Requests per minute per IP, all routes (polling included).
RATE_LIMIT_RPM=300
# Scan creations per minute per IP.
SCAN_RATE_LIMIT_RPM=10
# Max concurrent Chromium contexts, and how many scans may wait for one.
BROWSER_MAX_CONTEXTS=4
SCAN_QUEUE_MAX=20
# Max wait for the page's network to go quiet before checking, in ms.
NETWORK_IDLE_MAX_MS=5000

# --- URL and subresource safety ---
# Allow scanning localhost/private networks. Dev only: the server refuses to start with this
# in production. The UI shows a warning badge while it is on.
ALLOW_PRIVATE_URLS=false
# Per response (after decompression), unique URLs per scan, redirects for the page, per-request timeout.
MAX_RESPONSE_BYTES=15000000
MAX_SUBREQUESTS=100
MAX_REDIRECTS=5
SUBREQUEST_TIMEOUT_MS=10000

# In-memory store size (least recently used scans are evicted).
STORE_MAX_SCANS=200

# --- Standard ---
# AAA rules are off by default (WCAG 2.2 AA target).
INCLUDE_AAA=false

# --- LLM (optional; Phase 3) ---
# none | openai-compatible | mock
LLM_PROVIDER=none
# Any OpenAI-compatible endpoint: OpenAI, Gemini (OpenAI-compat), Groq, OpenRouter, Ollama.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# Cheap text model for link/button names and wording.
LLM_MODEL_CHEAP=
# Vision-capable model for alt text (only sees images already captured during the scan).
LLM_MODEL_VISION=
# Optional stronger model. Low-confidence or invalid JSON is retried once on this (or on cheap if unset).
LLM_MODEL_STRONG=
# Price per 1M tokens in USD, used only for cost estimates. Check your provider's current pricing.
LLM_PRICE_INPUT_PER_M=0
LLM_PRICE_OUTPUT_PER_M=0
# Token budget for one scan (all LLM calls combined). Retries count against this.
LLM_TOKEN_BUDGET_PER_SCAN=8000
# Per-client daily cap. In-memory; resets on process restart. Relies on req.ip.
LLM_TOKEN_BUDGET_PER_IP_DAY=100000
# Provider limits, used by the client-side token bucket.
LLM_RPM=30
LLM_TPM=60000
# Honour X-Forwarded-For so per-IP budgets don't collapse every visitor onto the proxy.
# Unset: off in development, on in production (Render/Vercel). Set false to disable.
# TRUST_PROXY=false

# --- Store ---
# memory (default, demos) | mongo (requires MONGODB_URI; fails startup if missing)
STORE=memory
MONGODB_URI=
# Shared report links and stored scans/repairs/verifications expire after this many days.
SCAN_TTL_DAYS=30

# --- Screenshots (Phase A). Bytes stay in the one-hour memory cache, not Mongo. ---
# Default on. A failed shot never fails the scan. Set false to skip capture.
SCREENSHOTS=true
SCREENSHOT_QUALITY=60
SCREENSHOT_MAX_BYTES=500000
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=720

# --- Frontend (Vite reads VITE_* from this root file) ---
VITE_API_BASE_URL=http://localhost:4000
# Set false to restore the single-column results view (no screenshot workbench).
# VITE_VISUAL=false
